<?xml version="1.0" encoding="utf-8"?>
<!-- Logo "Onda": un vinilo cuyo centro es un botón de play hecho de barras de ecualizador. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- Disco -->
    <path android:fillColor="#FF101219"
        android:pathData="M54,24 a30,30 0 1,0 0.01,0 Z"/>
    <!-- Surcos -->
    <path android:strokeColor="#22FFFFFF" android:strokeWidth="0.6"
        android:pathData="M54,27.5 a26.5,26.5 0 1,0 0.01,0 Z"/>
    <path android:strokeColor="#16FFFFFF" android:strokeWidth="0.6"
        android:pathData="M54,30.5 a23.5,23.5 0 1,0 0.01,0 Z"/>
    <!-- Brillo del vinilo -->
    <path android:strokeColor="#33FFFFFF" android:strokeWidth="1.2" android:strokeLineCap="round"
        android:pathData="M33,38 A26.5,26.5 0 0,1 46,28.7"/>
    <!-- Aro de neón -->
    <path android:strokeWidth="2.6"
        android:pathData="M54,24 a30,30 0 1,0 0.01,0 Z">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="24" android:startY="24" android:endX="84" android:endY="84">
                <item android:offset="0" android:color="#FF00E5FF"/>
                <item android:offset="1" android:color="#FFFF2E88"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- Play hecho de barras -->
    <path android:strokeWidth="4" android:strokeLineCap="round"
        android:pathData="M46,40.40 L46,67.60 M52,44.00 L52,64.00 M58,47.60 L58,60.40 M64,51.20 L64,56.80 M70,53.99 L70,54.01">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="44" android:startY="40" android:endX="72" android:endY="68">
                <item android:offset="0" android:color="#FF00E5FF"/>
                <item android:offset="1" android:color="#FFFF2E88"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
